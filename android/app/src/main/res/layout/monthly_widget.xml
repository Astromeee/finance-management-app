<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Ledger" android:fontFamily="serif" android:textSize="24sp" android:textColor="#2B241D" />
        <TextView android:id="@+id/monthly_refresh" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="↻" android:textSize="26sp" android:textColor="#AD4416" android:contentDescription="Refresh monthly spending" />
    </LinearLayout>
    <TextView android:id="@+id/monthly_month" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="THIS MONTH" android:textSize="10sp" android:letterSpacing="0.15" android:textColor="#756956" />
    <TextView android:id="@+id/monthly_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="—" android:textSize="32sp" android:fontFamily="sans-serif-medium" android:textColor="#2B241D" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="32sp" />
    <LinearLayout android:id="@+id/monthly_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:id="@+id/monthly_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tap refresh to load your ledger" android:textSize="10sp" android:textColor="#756956" />
</LinearLayout>
